{
	"name": "better-forward-worker",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"test": "vitest",
		"cf-typegen": "wrangler types",
		"bot:info": "node scripts/get-bot-info.mjs",
		"webhook:set": "node scripts/set-webhook.mjs",
		"migrate:d1:local": "wrangler d1 migrations apply DB --local",
